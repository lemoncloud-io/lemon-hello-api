{
    "name": "lemon-hello-api",
    "version": "5.26.1030",
    "description": "Simplified Boilerplate of Serverless API",
    "main": "dist/index.js",
    "types": "dist/index.d.ts",
    "port": 8000,
    "scripts": {
        "!build": "------ build /src to /dist ----",
        "build": "npm run build-ts",
        "build-ts": "ttsc",
        "watch-ts": "ttsc -w",
        "nodemon": "nodemon --config nodemon-main.json",
        "!start": "------ run in local development (note! ts-node seems not watch '.js' file) ----",
        "*start": "nodemon --watch src --exec ts-node --compiler typescript -r tsconfig-paths/register src/index.ts",
        "start": "npm run build && concurrently -k -p \"[{name}]\" -n \"TypeScript,Node\" -c \"cyan.bold,green.bold\" \"npm run watch-ts\" \"npm run nodemon\"",
        "!express": "---- run express server in local (LOCAL_MODE=1: lemon-core local mode; express: SNS/SQS/protocol sends to this service are delivered in-process, express.aws: real AWS) -----",
        "express": "ENV=none STAGE=local LOCAL_MODE=1 LOCAL_TRANSPORT=mock npm run start",
        "express.aws": "ENV=none STAGE=local LOCAL_MODE=1 npm run start",
        "!deploy": "----- deploy to AWS by serverless -----",
        "deploy": "npm run build && sls deploy --param='profile=none' --stage dev",
        "deploy.prod": "npm run build && sls deploy --param='profile=none' --stage prod",
        "!lemon": "----- deploy to `lemon` account (aws-profile is explicit to avoid mis-targeting) -----",
        "deploy.lemon": "npm run build && sls deploy --param='profile=lemon' --stage dev --aws-profile lemon",
        "deploy.lemon.prod": "npm run build && sls deploy --param='profile=lemon' --stage prod --aws-profile lemon",
        "pack.lemon": "npm run build && sls package --param='profile=lemon' --stage dev",
        "info.lemon": "sls info --param='profile=lemon' --stage dev --aws-profile lemon",
        "logs.lemon": "sls logs --param='profile=lemon' --stage dev --aws-profile lemon -t --startTime 5m -f lambda",
        "remove.lemon": "sls remove --param='profile=lemon' --stage dev --aws-profile lemon",
        "!info": "------- print sls infor by profile -----",
        "info": "sls info --param='profile=none' --stage dev",
        "info.prod": "sls info --param='profile=none' --stage prod",
        "!pack": "------- build gulp and prepare to release -----",
        "pack": "npm run build && sls package --param='profile=none' --stage dev",
        "pack.prod": "npm run build && sls package --param='profile=none' --stage prod",
        "!logs": "------- print logs of serverless by profile -----",
        "logs": "sls logs --param='profile=none' --stage dev -t --startTime 5m -f lambda",
        "logs.prod": "sls logs --param='profile=none' --stage prod -t --startTime 5m -f lambda",
        "!remove": "----- sls remove by profile -----",
        "remove": "sls remove --param='profile=none' --stage dev",
        "remove.prod": "sls remove --param='profile=none' --stage prod",
        "!lambda": "------- invoke the deployed lambda / watch its logs (lemon-core `lemon-*` commands, HOW_TO_UPGRADE_V5 § 19) -----",
        "lambda:invoke": "lemon-lambda-invoke",
        "lambda:logs": "lemon-lambda-logs",
        "perf:lambda": "lemon-lambda-perf",
        "!test": "------- run self-test with jest -----",
        "test": "LS=1 jest --config=jest.config.json",
        "test:watch": "ENV=none LS=1 jest --config=jest.config.json --watchAll",
        "test.local": "ENV=none STAGE=local npm test",
        "!plato": "----- analysis code complexity -----",
        "plato": "plato -r -d complexity dist"
    },
    "dependencies": {
        "@aws-sdk/client-iam": "^3.1159.0",
        "@aws-sdk/client-kms": "^3.1159.0",
        "@aws-sdk/client-lambda": "^3.1159.0",
        "@aws-sdk/client-s3": "^3.1159.0",
        "@aws-sdk/client-sns": "^3.1159.0",
        "@aws-sdk/client-sqs": "^3.1159.0",
        "@aws-sdk/client-sts": "^3.1159.0",
        "@aws-sdk/credential-providers": "^3.1159.0",
        "lemon-core": "^5.0.15"
    },
    "devDependencies": {
        "@aws-sdk/client-cloudwatch-logs": "^3.1159.0",
        "@cruglobal/serverless-merge-config": "^1.1.0",
        "@types/cors": "^2.8.7",
        "@types/jest": "^27.5.0",
        "@types/node": "^18.0.0",
        "@types/supertest": "^2.0.10",
        "@typescript-eslint/eslint-plugin": "^5.22.0",
        "@typescript-eslint/parser": "^5.22.0",
        "codecov": "^3.7.2",
        "concurrently": "^5.3.0",
        "eslint": "^8.14.0",
        "eslint-config-prettier": "^8.5.0",
        "eslint-plugin-prettier": "^4.0.0",
        "jest": "^27.5.1",
        "lint-staged": "^13.1.0",
        "nodemon": "^2.0.20",
        "prettier": "^2.6.2",
        "serverless": "^3.19.0",
        "serverless-aws-documentation": "^0.8.0",
        "serverless-plugin-log-retention": "^2.1.0",
        "serverless-prune-plugin": "^2.0.1",
        "superagent": "^5.3.1",
        "supertest": "^4.0.2",
        "ts-jest": "^27.1.4",
        "ts-node": "8.1.0",
        "ts-transformer-keys": "^0.4.4",
        "tsconfig-paths": "^4.1.2",
        "ttypescript": "^1.5.15",
        "typescript": "^4.7.4"
    },
    "private": false,
    "author": "Steve Jung <steve@lemoncloud.io> (https://eureka.codes)",
    "license": "MIT",
    "files": [
        "handler.js",
        "dist/**/*"
    ],
    "engines": {
        "node": ">=24.0.0"
    },
    "keywords": [
        "eureka.codes",
        "lemon-core",
        "serverless"
    ],
    "bugs": {
        "url": "https://github.com/lemoncloud-io/lemon-hello-api/issues",
        "email": "steve@lemoncloud.io"
    },
    "contributors": [
        "Louis <louis@lemoncloud.io>"
    ],
    "homepage": "https://github.com/lemoncloud-io/lemon-hello-api#readme",
    "repository": {
        "type": "git",
        "url": "git@github.com:lemoncloud-io/lemon-hello-api.git"
    }
}
